{
  "name": "concept_sentence",
  "source": {
    "dataset": "parquet",
    "repository": "GEM/common_gen",
    "data_files": {
      "train": "hf://datasets/GEM/common_gen@refs/convert/parquet/default/train/0000.parquet",
      "validation": "hf://datasets/GEM/common_gen@refs/convert/parquet/default/validation/0000.parquet"
    },
    "train_split": "train",
    "validation_split": null,
    "test_split": "validation",
    "heldout_fraction": 0.1,
    "group_field": "concepts"
  },
  "prompt_template": "### Instruction:\nWrite one natural sentence that uses all the supplied concepts.\n\n### Concepts:\n{concepts}\n\n### Sentence:\n",
  "response_field": "target",
  "field_transforms": {"concepts": "join_comma"},
  "base_model": "HuggingFaceTB/SmolLM2-135M",
  "max_length": 128,
  "evaluation": {
    "metric": "concept_coverage_exact",
    "generation_examples": 32,
    "max_new_tokens": 40
  },
  "training": {
    "method": "lora",
    "train_samples": 512,
    "validation_samples": 64,
    "learning_rate": 0.0002,
    "epochs": 1,
    "batch_size": 1,
    "gradient_accumulation_steps": 1,
    "lora_rank": 8,
    "lora_alpha": 16,
    "lora_dropout": 0.05,
    "lora_targets": ["q_proj", "v_proj"]
  }
}
